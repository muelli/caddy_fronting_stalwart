{% import 'macros.j2' as macros with context %}
{{ item.name }} {

    # --- 1. DYNAMIC INVENTORY OVERRIDES ---
    {{ item.caddy_directive | default("") | indent(4) }}

    # --- 2. UNIVERSAL FALLBACK MAIL ROUTING ---
    handle {
        {# Explicitly fail if listener variable is missing from inventory #}
        reverse_proxy {{ stalwart_http_proxyv2_listener }} {
            transport http {
                proxy_protocol v2
            }
        }
    }

    # --- 3. UNIFIED TLS DEFINITION ---
    tls {
        {{ macros.render_caddy_dns(item.dns, dns_key_map, caddy_dns_field_map) | indent(8) }}
        # propagation_delay 30s
    }
}
