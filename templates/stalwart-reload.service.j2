[Unit]
Description=Safely Hot-Reload Stalwart Settings Natively
After=stalwart.service
Requisite=stalwart.service
PartOf=stalwart.service

[Service]
Type=oneshot
{% if stalwart_api_token is defined and stalwart_api_token %}
Environment="STALWART_TOKEN={{ stalwart_api_token }}"
ExecStart={{ stalwart_cli_path | default('stalwart-cli') }} --url {{ stalwart_api_url }} create action/ReloadSettings
{% else %}
ExecStart={{ stalwart_cli_path | default('stalwart-cli') }} --url {{ stalwart_api_url }} --user {{ stalwart_admin_user }} --password "{{ stalwart_admin_password }}" create action/ReloadSettings
{% endif %}
