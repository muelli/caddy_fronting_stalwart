[Service]
{% if caddy_service_override_lines is defined and caddy_service_override_lines %}
# Custom service directives
{{ caddy_service_override_lines.strip() }}
{% endif %}

# Dynamic DNS API Keys
{% set unique_providers = [] %}
{% for domain in mail_domains if domain.state == 'present' %}
  {% if domain.dns not in unique_providers %}
    {% set _ = unique_providers.append(domain.dns) %}
    {% set credentials = dns_key_map[domain.dns] %}
    {% if credentials is mapping %}
      {# Multi-key provider (like Spaceship) #}
      {% for key, value in credentials.items() %}
Environment="{{ domain.dns | upper }}_{{ key | upper }}={{ value }}"
      {% endfor %}
    {% else %}
      {# Single-key provider (like Hetzner) #}
Environment="{{ domain.dns | upper }}_API_KEY={{ credentials }}"
    {% endif %}
  {% endif %}
{% endfor %}
